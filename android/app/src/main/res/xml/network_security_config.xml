<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP, scoped to exactly the hosts the mock API server (api/mock-server/)
  can be reached at — never a blanket allow-all. The real API will be HTTPS; this
  exists only so the app can talk to a plain-HTTP dev server on the same machine.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
